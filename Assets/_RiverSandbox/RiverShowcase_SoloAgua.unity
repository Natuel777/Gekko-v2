  m_Script: {fileID: 11500000, guid: 32dc70cd8a90b2a4fb2e5507e7982606, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Title: 'API: Sample, AddSplash, Splashed'
  Description: "Cada flecha es un <b>RiverProbe</b> que llama a <b>river.Sample(posicion,
    out s)</b> y dibuja s.FlowVelocity. Asi se ve el \"campo\" de corriente: mas
    rapido en lo angosto.\n\nDesde codigo:\n  river.Sample(pos, out var s)  -> s.Inside,
    s.SurfaceY, s.FlowVelocity\n  river.AddSplash(pos, fuerza)  -> onda + evento\n 
    river.Splashed += (pos, fuerza) => { sonido / particulas }\n  river.PointAt(distancia,
    lateral01)  -> punto sobre el agua"
  BallSpawn: {fileID: 104297110}
  Yaw: 0
  Pitch: 72
  Distance: 46
